{
  "name": "plot-ledger",
  "version": "1.5.2",
  "nativeBuild": 106,
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43123",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 43123",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-plot-ledger \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-plot-ledger \"playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-plot-ledger",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed.ts --with-payments",
    "postinstall": "next typegen",
    "build:native": "NEXT_OUTPUT=export next build && cap sync",
    "cap:sync": "cap sync",
    "android:apk": "pnpm build:native && cd android && ./gradlew assembleDebug",
    "assets:generate": "capacitor-assets generate --android --ios --iconBackgroundColor \"#0e1117\" --iconBackgroundColorDark \"#0e1117\" --splashBackgroundColor \"#0b0d10\" --splashBackgroundColorDark \"#0b0d10\"",
    "build:native:prod": "set -a && . ./.env.production && set +a && CAP_USE_EMULATORS=false pnpm build:native",
    "android:apk:prod": "pnpm build:native:prod && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-updater": "8.53.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4"
}
