rules_version = '2';
// Rules for a private six-person plot ledger. These rules are the source of truth;
// the UI only mirrors them.
//
// Roles
//   - linked member: a users/{uid} profile whose personId names a roster person that
//     links back to the same uid (people/{personId}.linkedUid == uid). Reads the whole
//     ledger and records payments ONLY for their own person.
//   - unlinked account: signed up but not linked yet. Reads only its own profile and
//     settings/access, and sees "Ask the admin to link your account".
//   - admin (settings/access.adminUids): manages the roster, linking and admins, and can
//     read the ledger. Admins get NO extra payment powers: nobody can record, edit or
//     delete money for somebody else.
//
// Payments: create own only. Edit / delete own only, by the person who created the
// entry, within 24 hours of creating it; after that an entry is permanent. Every write
// can be paired with an audit entry, and audit entries can never change.
// There is no public read or write.
//
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: settings
// Document ID: access
// Fields:
//   - adminUids: list<string> (required, 1..6 uids, each 8..128 chars)
//   - createdAt: timestamp (required, immutable)
// Create: the first signed-in member, and only while the doc is absent,
//         may create it with adminUids == [their own uid].
// Update: an existing admin, who must remain in the list.
//
// Collection: users
// Document ID: request.auth.uid
// Fields:
//   - email: string (required, must match the auth token, immutable, <= 200)
//   - displayName: string (required, 1..80)
//   - personId: string or null (required; null on self-create; admin may link an existing person)
//   - createdAt: timestamp (required, immutable)
// Read: the owner or an admin. Emails are not readable by other members.
// No role field. Admin authority lives only in settings/access.
//
// Collection: people
// Document ID: stable roster id (ananya, rohan, kavita, arjun, meera, suresh)
// Fields:
//   - name: string (required, 1..80)
//   - role: "contributor" | "homeowner"
//   - color: string #rrggbb
//   - sortOrder: int 0..20
//   - linkedUid: string uid or null (must name an existing user when set)
//   - linkedLabel: string 0..80 (display name only, no email)
// Clients may update (admin only). Create and delete are denied; the Admin SDK seeds the six people.
//
// Collection: payments
// Document ID: auto-id
// Fields:
//   - personId: string (required, existing person, <= 40)
//   - amountPaise: int (required, > 0, <= 10 crore rupees in paise)
//   - date: timestamp (required)
//   - note: string (required, may be empty, <= 500)
//   - createdBy: string uid (required, must be the signer on create, immutable)
//   - updatedBy: string uid (required, must be the signer)
//   - createdAt: timestamp (required, request.time on create, immutable)
//   - updatedAt: timestamp (required, request.time)
// Read: linked members and admins.
// Create: a linked member, for their own personId only, createdBy/updatedBy == signer.
// Update / delete: the creator, still linked to the same person, within 24h of createdAt;
//   personId, createdBy and createdAt cannot change.
//
// Collection: audit
// Document ID: auto-id
// Fields:
//   - action: "create" | "update" | "delete"
//   - entity: "payment" | "person" | "access"
//   - entityId: string 1..80
//   - actorUid: string (must be the signer)
//   - actorName: string (must equal the signer's users/{uid}.displayName)
//   - summary: string 1..400
//   - at: timestamp (request.time)
// Create: payment entries by the member whose payment it describes (checked against
//   the payment write in the same batch); person / access entries by admins.
// Update and delete: denied.
//
// Client queries: collection reads of people, payments, and audit with no where/orderBy
// (sorting is client-side). users is read as a single document by members and as a
// collection by admins. settings/access is a single-document read.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function accessPath() {
      return /databases/$(database)/documents/settings/access;
    }

    function personPath(personId) {
      return /databases/$(database)/documents/people/$(personId);
    }

    function isMember() {
      return isAuthenticated() && exists(userPath(request.auth.uid));
    }

    function myPersonId() {
      return get(userPath(request.auth.uid)).data.personId;
    }

    // Linked both ways: the profile names the person and the person names this uid.
    function isLinked() {
      return isMember()
        && myPersonId() is string
        && exists(personPath(myPersonId()))
        && get(personPath(myPersonId())).data.linkedUid == request.auth.uid;
    }

    function canReadLedger() {
      return isLinked() || isAdmin();
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    // own payment, still editable: created by the signer, for the signer's person, < 24h old
    function ownsEditablePayment(data) {
      return isLinked()
        && data.createdBy == request.auth.uid
        && data.personId == myPersonId()
        && request.time < data.createdAt + duration.value(24, 'h');
    }

    function isAdmin() {
      return isMember()
        && exists(accessPath())
        && request.auth.uid in get(accessPath()).data.adminUids;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isUid(value) {
      return value is string && value.size() >= 8 && value.size() <= 128;
    }

    function validAdminUidList(uids) {
      return uids is list
        && uids.size() >= 1
        && uids.size() <= 6
        && isUid(uids[0])
        && (uids.size() < 2 || isUid(uids[1]))
        && (uids.size() < 3 || isUid(uids[2]))
        && (uids.size() < 4 || isUid(uids[3]))
        && (uids.size() < 5 || isUid(uids[4]))
        && (uids.size() < 6 || isUid(uids[5]));
    }

    function isValidAccess(data) {
      return data.keys().hasOnly(['adminUids', 'createdAt'])
        && validAdminUidList(data.adminUids)
        && data.createdAt is timestamp;
    }

    function isValidPersonId(personId) {
      return personId is string
        && personId.size() > 0
        && personId.size() <= 40
        && exists(personPath(personId));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['email', 'displayName', 'personId', 'createdAt'])
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 200
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && (data.personId == null || isValidPersonId(data.personId));
    }

    function isValidPerson(data) {
      return data.keys().hasOnly(['name', 'role', 'color', 'sortOrder', 'linkedUid', 'linkedLabel'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role in ['contributor', 'homeowner']
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 20
        && data.linkedLabel is string
        && data.linkedLabel.size() <= 80
        && (
          data.linkedUid == null
          || (isUid(data.linkedUid) && exists(userPath(data.linkedUid)))
        );
    }

    function isValidPayment(data) {
      return data.keys().hasOnly(['personId', 'amountPaise', 'date', 'note', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && isValidPersonId(data.personId)
        && data.amountPaise is int
        && data.amountPaise > 0
        && data.amountPaise <= 10000000000
        && data.date is timestamp
        && data.date >= timestamp.date(2000, 1, 1)
        && data.date <= request.time + duration.value(2, 'd')
        && data.note is string
        && data.note.size() <= 500
        && isUid(data.createdBy)
        && isUid(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAudit(data) {
      return data.keys().hasOnly(['action', 'entity', 'entityId', 'actorUid', 'actorName', 'summary', 'at'])
        && data.action in ['create', 'update', 'delete']
        && data.entity in ['payment', 'person', 'access']
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityId.size() <= 80
        && data.actorUid == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 80
        && data.actorName == get(userPath(request.auth.uid)).data.displayName
        && data.summary is string
        && data.summary.size() > 0
        && data.summary.size() <= 400
        && data.at is timestamp;
    }

    // A payment audit entry must describe a payment write by the same signer in the same
    // batch: create/update leave the payment updated by the signer; delete removes it.
    function paymentAuditMatches(data) {
      return (
          data.action in ['create', 'update']
          && existsAfter(paymentPath(data.entityId))
          && getAfter(paymentPath(data.entityId)).data.updatedBy == request.auth.uid
          && getAfter(paymentPath(data.entityId)).data.personId == myPersonId()
        )
        || (
          data.action == 'delete'
          && exists(paymentPath(data.entityId))
          && !existsAfter(paymentPath(data.entityId))
          && get(paymentPath(data.entityId)).data.personId == myPersonId()
        );
    }

    match /settings/access {
      allow read: if isMember();

      allow create: if isMember()
        && request.auth.token.email is string
        && !exists(accessPath())
        && isValidAccess(request.resource.data)
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && isValidAccess(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.auth.uid in request.resource.data.adminUids;

      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.personId == null
        && request.resource.data.createdAt == request.time
        && isValidUser(request.resource.data);

      allow update: if isValidUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (isOwner(uid) && request.resource.data.personId == resource.data.personId)
          || isAdmin()
        );

      allow delete: if false;
    }

    match /people/{personId} {
      allow read: if canReadLedger();
      allow create: if false;
      allow delete: if false;
      allow update: if isAdmin() && isValidPerson(request.resource.data);
    }

    match /payments/{paymentId} {
      allow read: if canReadLedger();

      // only for yourself: admins included, nobody records money for someone else
      allow create: if isLinked()
        && isValidPayment(request.resource.data)
        && request.resource.data.personId == myPersonId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsEditablePayment(resource.data)
        && isValidPayment(request.resource.data)
        && request.resource.data.personId == resource.data.personId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if ownsEditablePayment(resource.data);
    }

    match /audit/{auditId} {
      allow read: if canReadLedger();
      allow create: if isValidAudit(request.resource.data)
        && request.resource.data.at == request.time
        && (
          (request.resource.data.entity == 'payment' && isLinked() && paymentAuditMatches(request.resource.data))
          || (request.resource.data.entity != 'payment' && isAdmin())
        );
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
