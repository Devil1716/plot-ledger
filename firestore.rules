rules_version = '2';
// Rules for one private plot-ledger group. These rules are the source of truth;
// the UI only mirrors them.
//
// Sign-in: Google only. Profiles can only be created from a Google sign-in with a
// verified email (request.auth.token.firebase.sign_in_provider == 'google.com').
//
// Roles
//   - waiting account: signed in with Google, has a users/{uid} profile, but no admin has
//     approved it yet (not linked to a roster person). Reads only its own profile and
//     settings/access, and sees "Waiting for approval".
//   - member: a profile whose personId names a roster person that links back to the same
//     uid (people/{personId}.linkedUid == uid). Reads the whole ledger and records
//     payments ONLY for their own person.
//   - admin (settings/access.adminUids): approves accounts (creates a roster person from
//     the Google profile, or links an existing one), edits the roster (including marking
//     the 0% homeowner), and manages admins. Admins get NO extra payment powers: nobody
//     can record, edit or delete money for somebody else.
//   - first admin: while settings/access does not exist, a signed-in Google account may
//     create it naming only itself (one-time "claim admin"). After that only admins can
//     change the admin list.
//
// Payments: create own only. Edit / delete own only, by the person who created the
// entry, within 24 hours of creating it; after that an entry is permanent. Every write
// can be paired with an audit entry, and audit entries can never change.
// There is no public read or write.
//
// ===============================================================
// Data Model
// ===============================================================
//
// settings/access
//   - adminUids: list<string> (1..6 uids)        - createdAt: timestamp (immutable)
//   Create: one-time claim (see above). Update: an admin who stays in the list.
//
// users/{uid}  (uid == request.auth.uid)
//   - email: string (= Google email, immutable)  - displayName: string 1..80 (Google name)
//   - photoURL: string <= 2048 or null (Google photo)
//   - personId: string or null (null until an admin approves)
//   - createdAt: timestamp (immutable)
//   Read: owner or admin. Owner may refresh displayName/photoURL; only admins set personId.
//
// people/{personId}
//   - name 1..80, role "contributor" | "homeowner", color #rrggbb, sortOrder 0..50,
//     linkedUid (existing user uid or null), linkedLabel 0..80, photoURL (optional)
//   Read: members and admins. Create / update: admins. Delete: denied.
//
// payments/{auto-id}
//   - personId, amountPaise (int, 1..10 crore rupees), date, note <= 500,
//     createdBy, updatedBy, createdAt, updatedAt
//   Read: members and admins. Create: a member, for their own person only.
//   Update / delete: the creator, still linked to the same person, within 24h.
//
// audit/{auto-id}
//   - action, entity ("payment" | "person" | "access"), entityId, actorUid, actorName,
//     summary, at
//   Create: payment entries by the member whose payment it describes (checked against
//   the payment write in the same batch); person / access entries by admins. Immutable.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function accessPath() {
      return /databases/$(database)/documents/settings/access;
    }

    function personPath(personId) {
      return /databases/$(database)/documents/people/$(personId);
    }

    function isMember() {
      return isAuthenticated() && exists(userPath(request.auth.uid));
    }

    function isGoogle() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myPersonId() {
      return get(userPath(request.auth.uid)).data.personId;
    }

    // Linked both ways: the profile names the person and the person names this uid.
    function isLinked() {
      return isMember()
        && myPersonId() is string
        && exists(personPath(myPersonId()))
        && get(personPath(myPersonId())).data.linkedUid == request.auth.uid;
    }

    function canReadLedger() {
      return isLinked() || isAdmin();
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    // own payment, still editable: created by the signer, for the signer's person, < 24h old
    function ownsEditablePayment(data) {
      return isLinked()
        && data.createdBy == request.auth.uid
        && data.personId == myPersonId()
        && request.time < data.createdAt + duration.value(24, 'h');
    }

    function isAdmin() {
      return isMember()
        && exists(accessPath())
        && request.auth.uid in get(accessPath()).data.adminUids;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isUid(value) {
      return value is string && value.size() >= 8 && value.size() <= 128;
    }

    function validAdminUidList(uids) {
      return uids is list
        && uids.size() >= 1
        && uids.size() <= 6
        && isUid(uids[0])
        && (uids.size() < 2 || isUid(uids[1]))
        && (uids.size() < 3 || isUid(uids[2]))
        && (uids.size() < 4 || isUid(uids[3]))
        && (uids.size() < 5 || isUid(uids[4]))
        && (uids.size() < 6 || isUid(uids[5]));
    }

    function isValidAccess(data) {
      return data.keys().hasOnly(['adminUids', 'createdAt'])
        && validAdminUidList(data.adminUids)
        && data.createdAt is timestamp;
    }

    // personId as it will be after this write (an approval creates the person in the same batch)
    function isValidPersonIdAfter(personId) {
      return personId is string
        && personId.size() > 0
        && personId.size() <= 40
        && existsAfter(personPath(personId));
    }

    function isPhoto(value) {
      return value == null || (value is string && value.size() <= 2048);
    }

    function isValidPersonId(personId) {
      return personId is string
        && personId.size() > 0
        && personId.size() <= 40
        && exists(personPath(personId));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['email', 'displayName', 'photoURL', 'personId', 'createdAt'])
        && isPhoto(data.get('photoURL', null))
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 200
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && (data.personId == null || isValidPersonIdAfter(data.personId));
    }

    function isValidPerson(data) {
      return data.keys().hasOnly(['name', 'role', 'color', 'sortOrder', 'linkedUid', 'linkedLabel', 'photoURL'])
        && isPhoto(data.get('photoURL', null))
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role in ['contributor', 'homeowner']
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 50
        && data.linkedLabel is string
        && data.linkedLabel.size() <= 80
        && (
          data.linkedUid == null
          || (isUid(data.linkedUid) && exists(userPath(data.linkedUid)))
        );
    }

    function isValidPayment(data) {
      return data.keys().hasOnly(['personId', 'amountPaise', 'date', 'note', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && isValidPersonId(data.personId)
        && data.amountPaise is int
        && data.amountPaise > 0
        && data.amountPaise <= 10000000000
        && data.date is timestamp
        && data.date >= timestamp.date(2000, 1, 1)
        && data.date <= request.time + duration.value(2, 'd')
        && data.note is string
        && data.note.size() <= 500
        && isUid(data.createdBy)
        && isUid(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAudit(data) {
      return data.keys().hasOnly(['action', 'entity', 'entityId', 'actorUid', 'actorName', 'summary', 'at'])
        && data.action in ['create', 'update', 'delete']
        && data.entity in ['payment', 'person', 'access']
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityId.size() <= 80
        && data.actorUid == request.auth.uid
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 80
        && data.actorName == get(userPath(request.auth.uid)).data.displayName
        && data.summary is string
        && data.summary.size() > 0
        && data.summary.size() <= 400
        && data.at is timestamp;
    }

    // A payment audit entry must describe a payment write by the same signer in the same
    // batch: create/update leave the payment updated by the signer; delete removes it.
    function paymentAuditMatches(data) {
      return (
          data.action in ['create', 'update']
          && existsAfter(paymentPath(data.entityId))
          && getAfter(paymentPath(data.entityId)).data.updatedBy == request.auth.uid
          && getAfter(paymentPath(data.entityId)).data.personId == myPersonId()
        )
        || (
          data.action == 'delete'
          && exists(paymentPath(data.entityId))
          && !existsAfter(paymentPath(data.entityId))
          && get(paymentPath(data.entityId)).data.personId == myPersonId()
        );
    }

    match /settings/access {
      allow read: if isMember();

      // one-time claim: only while no admin exists, by a Google member, naming only itself
      allow create: if isMember()
        && isGoogle()
        && !exists(accessPath())
        && isValidAccess(request.resource.data)
        && request.resource.data.adminUids.size() == 1
        && request.resource.data.adminUids[0] == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && isValidAccess(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.auth.uid in request.resource.data.adminUids;

      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && isGoogle()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.personId == null
        && request.resource.data.createdAt == request.time
        && isValidUser(request.resource.data);

      allow update: if isValidUser(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (isOwner(uid) && request.resource.data.personId == resource.data.personId)
          || isAdmin()
        );

      allow delete: if false;
    }

    match /people/{personId} {
      allow read: if canReadLedger();
      allow create: if isAdmin()
        && personId.size() <= 40
        && personId.matches('^[A-Za-z0-9_-]+$')
        && isValidPerson(request.resource.data);
      allow delete: if false;
      allow update: if isAdmin() && isValidPerson(request.resource.data);
    }

    match /payments/{paymentId} {
      allow read: if canReadLedger();

      // only for yourself: admins included, nobody records money for someone else
      allow create: if isLinked()
        && isValidPayment(request.resource.data)
        && request.resource.data.personId == myPersonId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsEditablePayment(resource.data)
        && isValidPayment(request.resource.data)
        && request.resource.data.personId == resource.data.personId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if ownsEditablePayment(resource.data);
    }

    match /audit/{auditId} {
      allow read: if canReadLedger();
      allow create: if isValidAudit(request.resource.data)
        && request.resource.data.at == request.time
        && (
          (request.resource.data.entity == 'payment' && isLinked() && paymentAuditMatches(request.resource.data))
          || (request.resource.data.entity != 'payment' && isAdmin())
        );
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
